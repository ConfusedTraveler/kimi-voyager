    "url": "https://github.com/ConfusedTraveler/kimi-voyager.git"
  },
  "bugs": {
    "url": "https://github.com/ConfusedTraveler/kimi-voyager/issues"
  },
  "homepage": "https://github.com/ConfusedTraveler/kimi-voyager#readme",
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-web-extension": "^4.1.1"
  },
  "dependencies": {
    "marked": "^11.1.1",
