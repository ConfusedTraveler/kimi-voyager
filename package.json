  "description": "An all-in-one enhancement suite for Kimi AI - folder management, prompt library, chat export and more.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "kimi",
    "moonshot",
    "ai",
